[Unit]
Description=Star Ring Alice web game
After=network.target

[Service]
Type=simple
User=neon-rift
Group=neon-rift
WorkingDirectory=/opt/neon-rift/app
EnvironmentFile=/etc/neon-rift.env
ExecStart=/usr/bin/node /opt/neon-rift/app/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/neon-rift

[Install]
WantedBy=multi-user.target
